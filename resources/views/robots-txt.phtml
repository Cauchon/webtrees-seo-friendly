<?php

declare(strict_types=1);

/**
 * @var array<string>    $bad_user_agents
 * @var string           $base_path
 * @var string           $base_url
 * @var string           $sitemap_url
 * @var iterable<string> $trees
 */

// A named user-agent group does not inherit the User-agent: * rules.
// Keep HTTP-blocked agents fully excluded; public crawlers use the wildcard group.
$blocked_agents = array_unique([...$bad_user_agents, 'Applebot-Extended']);
$tree_actions = [
    'ancestors', 'branches', 'calendar', 'compact', 'descendants',
    'family-book', 'family-list', 'fan-chart', 'hourglass',
    'individual-list', 'lifespans', 'media-objects', 'pedigree',
    'relationships', 'report', 'search', 'timeline',
];
$site_paths = ['admin', 'manager', 'moderator', 'editor', 'account'];
$module_paths = ['statistics_chart', 'tree'];

$lines = ['# robots.txt for ' . $base_url];
if ($base_path !== '') {
    $lines[] = '# Copy this output to the domain root for this robots.txt to take effect.';
}
$lines[] = '';
foreach ($blocked_agents as $blocked_agent) {
    $lines[] = 'User-agent: ' . $blocked_agent;
}
$lines[] = 'Disallow: /';
$lines[] = '';
$lines[] = 'User-agent: *';

// Cover clean URLs and both observed route query encodings. The wildcard
// variants cover route= when another query parameter comes first.
$append_path = static function (string $route_path) use (&$lines, $base_path): void {
    $encoded_route = str_replace('/', '%2F', $route_path);
    $lines[] = 'Disallow: ' . $base_path . $route_path;
    $lines[] = 'Disallow: ' . $base_path . '/index.php?route=' . $route_path;
    $lines[] = 'Disallow: ' . $base_path . '/index.php?route=' . $encoded_route;
    $lines[] = 'Disallow: ' . $base_path . '/index.php?*&route=' . $route_path;
    $lines[] = 'Disallow: ' . $base_path . '/index.php?*&route=' . $encoded_route;
};

foreach ($site_paths as $site_path) {
    $append_path('/' . $site_path);
}
foreach ($trees as $tree) {
    foreach ($tree_actions as $action) {
        // Prefixes also cover calendar-events, report-run, search variants,
        // and parameterized chart action names such as fan-chart-3-4-100.
        $append_path('/tree/' . rawurlencode($tree) . '/' . $action);
    }
}
foreach ($module_paths as $module_path) {
    $append_path('/module/' . $module_path);
}
$lines[] = 'Crawl-delay: 10';
$lines[] = '';
if ($sitemap_url !== '') {
    $lines[] = 'Sitemap: ' . $sitemap_url;
}

echo implode("\n", $lines) . "\n";
